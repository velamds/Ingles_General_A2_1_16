{"_data": [{"contents": [{"content": "Sally in China", "type": "lesson_name"}, {"content": "A Beijing Tour", "type": "unit_name"}, {"content": 2, "type": "position"}, {"content": "scholar > Exploring Ancient Sites > The Great Wall", "type": "origin"}, {"content": 16, "type": "lesson"}, {"content": "A2.1", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Accurately use information about places in a limited range of social situations.", "type": "primary"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_1"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_2"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_3"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_4"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_5"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_6"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_7"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": "detail ", "type": "name"}, {"content": "a piece of information about something", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I want a few more details about the tour. ", "type": "example"}, {"content": "engenn4le16ob02aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use to talk about things to do on a trip.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "rickshaw", "type": "name"}, {"content": "a small vehicle used in South East Asia for carrying one or two passengers", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We offer a rickshaw tour. ", "type": "example"}, {"content": "engenn4le16ob02aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "alley", "type": "name"}, {"content": "a narrow street between buildings", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You can explore the old alley.", "type": "example"}, {"content": "engenn4le16ob02aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "heaven", "type": "name"}, {"content": "the place where God is believed to live", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You can visit the Temple of Heaven.", "type": "example"}, {"content": "engenn4le16ob02aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "followed by", "type": "name"}, {"content": "after", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: You visit the square followed by the gardens.", "type": "example"}, {"content": "engenn4le16ob02aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Beijing ", "type": "name"}, {"content": "the capital city of China", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I want to go on a tour of Beijing. ", "type": "example"}, {"content": "engenn4le16ob02aud02", "type": "audio"}], "type": "target_word"}, {"content": "engenn4le16ob02re1img01.jpg", "type": "background_image"}, {"contents": [{"content": " Offers, Suggestions and Requests", "type": "heading"}, {"content": "When you make an <span class=\"strong\">offer</span>, you ask someone if they want your help to do something. <br/>  Example: <span class=\"italic\">Can I carry that for you</span>? <br/><br/>   When you make a <span class=\"strong\">suggestion</span>, you give ideas or ways to do something. <br/>  Example: <span class=\"italic\">We could go to the supermarket first</span>. <br/><br/>   When you make a <span class=\"strong\">request</span>, you ask someone for help or to do something. <br/>  Example: <span class=\"italic\">Could you help me?</span>", "type": "describer"}, {"content": "{\"rows\":4,\"columns\":3,\"cells\":[\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Ask/Make\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Respond\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Offer\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">How may I help you?</span><br/><span class=\\\"italic\\\"> Can you tell me about the sites?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I would like \u2026 </span><br/> <span class=\\\"italic\\\">Certainly.</span><br/><span class=\\\"italic\\\"> Of course.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Suggest\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"italic\\\">What do you suggest?</span><br/><span class=\\\"italic\\\"> You can take a tour.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> Great, thanks.</span><br> <span class=\\\"italic\\\">Thank you for the suggestion.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Request\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"italic\\\">Would you like to know about the tours we offer?</span><br/> <span class=\\\"italic\\\">Can I get your contact information?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"italic\\\">Yes, please.</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "Imagine you are talking to a tourist on the street.", "type": "text"}, {"content": "Write a dialogue between you and the tourist on the street (5-7 lines).", "type": "text"}, {"content": "The tourist asks for suggestions about what to do.", "type": "text"}, {"content": "Make suggestions. ", "type": "text"}, {"content": "Practice your dialogue aloud with a partner.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I ask for, make and respond to suggestions.", "type": "text"}, {"content": "I talk about things to do on a trip.", "type": "text"}, {"content": "I tell a partner my suggestions.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"contents": [{}], "template_override": 1, "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn4le16ob02re2img05.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn4le16ob02re2img05.jpg", "time": "100", "id": 1, "text": "<span class=\"strong\">Travel Agent</span>: Chinese Adventures, good morning! How may I help you? <br/>\n<span class=\"strong\">Sally</span>: Hello. I'd like to get a few more details about the Beijing tour. <br/>\n<span class=\"strong\">Travel Agent</span>: Certainly. What would you like to know?<br/>"}, {"image": "engenn4le16ob02re2img01.jpg", "time": "11000", "id": 2, "text": "<span class=\"strong\">Sally</span>: Could you tell me the sites we go to? <br/>\n<span class=\"strong\">Travel Agent</span>: Of course. On day one, you visit the Temple of Heaven. On the second day, you visit Tiananmen Square followed by the magnificent Forbidden City. <br/>"}, {"image": "engenn4le16ob02re2img02.jpg", "time": "24000", "id": 3, "text": "<span class=\"strong\">Sally</span>: Sounds good. What else do you suggest?<br/>\n<span class=\"strong\">Travel Agent</span>: You can take a rickshaw tour to explore the old Hutong alley.<br/>"}, {"image": "engenn4le16ob02re2img05.jpg", "time": "31500", "id": 4, "text": "<span class=\"strong\">Sally</span>: Sounds interesting, thank you. Could you book me for a guided tour?<br/>\n<span class=\"strong\">Travel Agent</span>: I can. What day is convenient for you?<br/>\n<span class=\"strong\">Sally</span>: Any day is okay.<br/>\n<span class=\"strong\">Travel Agent</span>: How about next Tuesday?<br/>\n<span class=\"strong\">Sally</span>: Perfect!<br/>"}, {"image": "engenn4le16ob02re2img05.jpg", "time": "45000", "id": 5, "text": "<span class=\"strong\">Travel Agent</span>: Can I get your e-mail please? I'm going to send you some more information.<br/>\n<span class=\"strong\">Sally</span>:  sdavis@mail.com"}], "audiosrc": "engenn4le16ob02re2aud01", "coverimg": "engenn4le16ob02re2img05.jpg"}, "type": "slideshow"}], "id": 1}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [], "audiosrc": "engenn4le16ob02re6aud04", "coverimg": "engenn4le16ob02re6img01.jpg"}, "type": "picture"}], "id": 2}], "exercises": [{"template_override": 1, "questions": [], "type": "WLC", "_data": [{"contents": [{"content": "Listening", "type": "skill"}, {"content": "Vocabulary and Grammar", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "I can talk about things to do or take on trips.", "type": "Learning Outcomes"}, {"content": "I can make and respond to offers and requests.", "type": "Learning Outcomes"}, {"content": "I can ask for, make and/or respond to suggestions.", "type": "Learning Outcomes"}, {"content": "What things do you like to do on a trip?", "type": "Free Header Item"}, {"content": "What is your favorite thing to do?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type":