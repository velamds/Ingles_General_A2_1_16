arget_word", "contents": [{"content": "ginger tea", "type": "name"}, {"content": "a hot liquid made from ginger", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Ginger tea helps with heartburn.", "type": "example"}, {"content": "engenn4le16ob07aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to absorb", "type": "name"}, {"content": "to take in a liquid, gas", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The tea absorbs the acid in your stomach.", "type": "example"}, {"content": "engenn4le16ob07aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to steep", "type": "name"}, {"content": "to put something in a liquid and leave it there", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Steep the ginger in boiling water.", "type": "example"}, {"content": "engenn4le16ob07aud10", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "calm your nerves", "type": "name"}, {"content": "use to say someone should relax and not worry ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Drink this; it helps calm your nerves.", "type": "example"}, {"content": "engenn4le16ob07aud01", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to contribute", "type": "name"}, {"content": "to help make something happen", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Your nerves contribute to heartburn.", "type": "example"}, {"content": "engenn4le16ob07aud09", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "freshly", "type": "name"}, {"content": "when food is not preserved", "type": "definition"}, {"content": "(adverb)", "type": "part_speech"}, {"content": "Example: Add one spoon of freshly ground pepper.", "type": "example"}, {"content": "engenn4le16ob07aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "grated", "type": "name"}, {"content": "in small pieces", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Is this grated ginger?", "type": "example"}, {"content": "engenn4le16ob07aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "herbal", "type": "name"}, {"content": "made of herbs", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Herbal teas help with many health issues.", "type": "example"}, {"content": "engenn4le16ob07aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "teaspoon ", "type": "name"}, {"content": "a small spoon that you use for measuring food or liquid", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You must add one teaspoon of honey.", "type": "example"}, {"content": "engenn4le16ob07aud07", "type": "audio"}]}, {"content": "engenn4le16ob07re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Talking About Health Problems ", "type": "heading"}, {"content": "<span class=\"strong\">Explaining a problem</span> <br/> You can use these sentences to describe your health problems:<br/> <span class=\"bullet\"> I am not feeling well. / I don't feel well.</span><br/> <span class=\"bullet\"> I have a cough.</span><br/> <span class=\"bullet\"> I have a stomach ache.</span><br/> <span class=\"bullet\"> I have heartburn.</span><br/>", "type": "describer"}, {"content": "<span class=\"strong\">Symptoms</span><br/> Symptoms are feelings of illness or discomfort. <br/><br/>  <span class=\"strong\">Diagnosis</span><br/> A diagnosis is when a doctor tells you the medical name of your problem.", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": "Must vs. Should", "type": "heading"}, {"content": "You can use the modals <span class=\"italic\">must</span> and <span class=\"italic\">should</span> to give recommendations.", "type": "describer"}, {"content": "You must drink some tea. <br/> You have to drink lots of herbal tea. <br/> You should add one teaspoon of sugar. <br/>", "type": "example"}, {"content": "<span class=\"strong\">Must</span> is a very strong recommendation. You can use <span class=\"strong\">have to</span> instead of must. <span class=\"strong\">Have to</span> is used as a strong obligation.<br/> <br/>  <span class=\"strong\">Should</span> is not as strong. It is a suggestion.", "type": "text"}]}, {"type": "takeaway_extension", "contents": [{"content": "Read this list of common health problems:<ul> <li>food allergy</li><li>hay fever</li> <li>insomnia</li></ul>", "type": "text"}, {"content": "Choose one of these. Do some research about it.", "type": "text"}, {"content": "Write three suggestions (<span class=\"italic\">You should ...</span>) and three strong recommendations (<span class=\"italic\">You must ...</span>) about what someone should do if they have this problem.", "type": "text"}, {"content": "Share your sentences with a partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I research a common health problem.", "type": "text"}, {"content": "I make suggestions and strong recommendations.", "type": "text"}, {"content": "I write complete sentences.", "type": "text"}, {"content": "I share my sentences with a partner.", "type": "text"}]}], "type": "sena", "labs": [{"exercises": [{"id": 0, "template_override": 1, "stimuli_ids": [0], "_data": [{"type": "instructions", "contents": [{"content": "I can ask and report about things and events.", "type": "Learning Outcomes"}, {"content": "I can talk about common health problems.", "type": "Learning Outcomes"}, {"content": "I can make strong recommendations.", "type": "Learning Outcomes"}, {"content": "What do you do when you feel sick?", "type": "Free Header Item"}, {"content": "Do you drink anything when you feel sick?