e": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to talk about food."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "anchovy"}, {"type": "definition", "content": "a very small fish that has a strong salty taste"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The stock is made of anchovies. "}, {"type": "audio", "content": "engenn4le16ob06aud01"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "mushroom"}, {"type": "definition", "content": "a small vegetable with a stem and round top"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The soup includes mushrooms."}, {"type": "audio", "content": "engenn4le16ob06aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "green onion"}, {"type": "definition", "content": "an onion with a small white round part and a long green stem"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example:  There is raw green onion in the soup."}, {"type": "audio", "content": "engenn4le16ob06aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "spinach"}, {"type": "definition", "content": "a vegetable with large dark green leaves"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The dish includes spinach. "}, {"type": "audio", "content": "engenn4le16ob06aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "cabbage "}, {"type": "definition", "content": "a large round vegetable with thick green or purple leaves"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I prefer cabbage over lettuce."}, {"type": "audio", "content": "engenn4le16ob06aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "bamboo shoot"}, {"type": "definition", "content": "the part of a young bamboo plant that yo