site and you must take lots of photographs!", "id": 2, "time": "40100"}]}}], "id": 2}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Sally in China", "type": "lesson_name"}, {"content": "The Forbidden City", "type": "unit_name"}, {"content": 10, "type": "position"}, {"content": "scholar > Delicious Food > China", "type": "origin"}, {"content": 16, "type": "lesson"}, {"content": "A2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately use information about travel and vacations in social situations.", "type": "primary"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_1"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_2"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_3"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_4"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_5"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_6"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_7"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_8"}]}, {"type": "target_word", "contents": [{"content": "exact ", "type": "name"}, {"content": "correct; true", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: It is located in the exact center of the city. ", "type": "example"}, {"content": "engenn4le16ob10aud02", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about an ancient site.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "vast ", "type": "name"}, {"content": "very large", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: It is a vast castle. ", "type": "example"}, {"content": "engenn4le16ob10aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to rename", "type": "name"}, {"content": "to give something a new name", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: It is now called the \u201cPalace Garden\u201d.", "type": "example"}, {"content": "engenn4le16ob10aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "foundation", "type": "name"}, {"content": "the solid layer of stone or cement that supports a building", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The workers made foundations from stone.", "type": "example"}, {"content": "engenn4le16ob10aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to construct", "type": "name"}, {"content": "to build", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: They constructed the building from wood.", "type": "example"}, {"content": "engenn4le16ob10aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "moat ", "type": "name"}, {"content": "a wide hole filled with water around a castle as a defence", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: A 164-foot-wide moat encircles the city.", "type": "example"}, {"content": "engenn4le16ob10aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to encircle", "type": "name"}, {"content": "to surround something completely ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The moat encircles the city. ", "type": "example"}, {"content": "engenn4le16ob10aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "directly ", "type": "name"}, {"content": "exactly in a particular position ", "type": "definition"}, {"content": "(adverb)", "type": "part_speech"}, {"content": "Example: The Forbidden City is located directly to the north of the square.", "type": "example"}, {"content": "engenn4le16ob10aud01", "type": "audio"}]}, {"type": "learning_points", "contents": [{"content": "Must vs. Should", "type": "heading"}, {"content": "You can use the modals must and should to give recommendations.", "type": "describer"}, {"content": "<span class = \"strong\">Must</span> is a very strong recommendation. You can use <span class = \"strong\">have to</span> instead of must. <span class=\"strong\">Have to</span> is used as an obligation. You can use \u201chave to\u201d when you speak.  <span class = \"strong\">Should</span> is not as strong. It is a suggestion.", "type": "text"}, {"content": "You must visit this castle! ", "type": "example"}, {"content": "You should go on a boat ride. ", "type": "example"}, {"content": "You shouldn't forget your camera.", "type": "example"}, {"content": "You mustn't forget to take a picture outside.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "The Simple Past Tense ", "type": "heading"}, {"content": "When you travel, you ask and report about things you see. You can use the Simple Past tense to report about things you saw or didn't see. ", "type": "describer"}, {"content": "Remember, there are regular and irregular verbs.", "type": "text"}, {"content": "This vast palace was the home for 24 different emperors.", "type": "example"}, {"content": "The Ming and Qing dynasties lived there until 1912.", "type": "example"}, {"content": " The workers made foundations from stone.", "type": "example"}, {"content": "They built the walls with brick and they constructed most of the buildings using wood.", "type": "example"}]}, {"content": "engenn4le16ob10re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Choose an attraction in the world. Research it on the Internet.", "type": "text"}, {"content": "Write 5-7 sentences about this attraction.", "type": "text"}, {"content": "Write 2 recommendations about why your friend must visit this attraction.", "type": "text"}, {"content": "Read your sentences and recommendations aloud.", "type": "text"}, {"content": "Listen to a partner's recommendation.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about attractions.", "type": "text"}, {"content": "I make strong recommendations.", "type": "text"}, {"content": "I report about things.", "type": "text"}, {"content": "I listen to my partner's recommendation.", "type": "text"}]}]}