pe": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about travel and vacations in social situations."}, {"type": "secondary_1", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_2", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_3", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_4", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_5", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_6", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_7", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_8", "content": "Identifies general information in short written or spoken conversations."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "exact "}, {"type": "definition", "content": "refers to a certain, particular location"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: It is located at the exact center of the city. "}, {"type": "audio", "content": "engenn4le16ob10aud02"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to talk about an ancient site."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "vast "}, {"type": "definition", "content": "very large"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: It is a vast castle. "}, {"type": "audio", "content": "engenn4le16ob10aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to rename"}, {"type": "definition", "content": "to give something a new name"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: It is now renamed as \u201cPalace Garden\u201d."}, {"type": "audio", "content": "engenn4le16ob10aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "foundation"}, {"type": "definition", "content": "the solid layer of cement or stone that is put under a building to support it"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The foundation is made of stone. "}, {"type": "audio", "content": "engenn4le16ob10aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to construct"}, {"type": "definition", "content": "to build"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: They constructed the building from wood."}, {"type": "audio", "content": "engenn4le16ob10aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "moat "}, {"type": "definition", "content": "a wide hole filled with water around a castle as a defence"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Use the bridge to cross the moat."}, {"type": "audio", "content": "engenn4le16ob10aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to encircle"}, {"type": "definition", "content": "to surround something completely "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: The moat encircles the city. "}, {"type": "audio", "content": "engenn4le16ob10aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "directly "}, {"type": "definition", "content": "exactly in a particular position "}, {"type": "part_speech", "content": "(adverb)"}, {"type": "example", "content": "Example: The Forbidden City is located directly to the north of the square."}, {"type": "audio", "content": "engenn4le16ob10aud01"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Must vs. Should"}, {"type": "describer", "content": "You can use the modals must and should to give recommendations."}, {"type": "text", "content": "<span class = \"strong\">Must</span> is a very strong recommendation. You can use <span class = \"strong\">have to</span> instead of must. <span class=\"strong\">Have to</span> is used as an obligation. You can use \u201chave to\u201d when you speak.  <span class = \"strong\">Should</span> is not as strong. It is a suggestion."}, {"type": "example", "content": "You must visit this castle! "}, {"type": "example", "content": "You should go on a boat ride. "}, {"type": "example", "content": "You shouldn't forget your camera."}, {"type": "example", "content": "You mustn't forget to take a picture outside"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Simple Past Tense "}, {"type": "describer", "content": "When you travel, you ask and report about things you see. You can use the Simple Past tense to report about things you saw or didn't see. "}, {"type": "text", "content": "Remember, there are regular and irregular verbs."}, {"type": "example", "content": "I visited a castle. "}, {"type": "example", "content": "I saw many things.  "}, {"type": "example", "content": "The castle is renamed."}, {"type": "example", "content": "I didn't visit that attraction you told me about. "}]}, {"type": "background_image", "content": "engenn4le16ob10re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Choose an attraction in the world. Research it on the internet."}, {"type": "text", "content": "Write 5-7 sentences about this attraction."}, {"type": "text", "content": "Write 2 recommendations about why your friend must visit this attraction."}, {"type": "text", "content": "Read your sentences and recommendations aloud."}, {"type": "text", "content": "Listen to a partner's recommendation."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I talk about attractions."}, {"type": "text", "content": "I make strong recommendations."}, {"type": "text", "content": "I report about things."}, {"type": "text", "content": "I listen to my partner's recommendation."}]}], "type": "sena"}