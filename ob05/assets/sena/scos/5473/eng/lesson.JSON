ntent": "", "type": "text"}]}], "responses": [{"_data": [{"content": "", "type": "text"}], "correct": 0, "id": 0, "selected": 0}, {"_data": [{"content": "", "type": "text"}], "correct": 1, "id": 1, "selected": 0}], "id": 0}]}, {"stimuli_ids": [], "id": 11, "_data": [{"type": "instructions", "contents": [{"content": "How do you make your favorite dish? ", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!"}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment. ", "type": "text"}]}], "type": "DWS", "template_override": 1, "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn4le16ob05re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"_data": [{"content": "", "type": "text"}], "correct": 1, "id": 0, "selected": 0}], "id": 0}]}], "stimuli": [{"_data": [], "type": "welcome", "id": 0, "template_override": 1, "contents": [{}]}, {"_data": [], "id": 1, "contents": [{"type": "slideshow", "value": {"coverimg": "engenn4le16ob05re2img05.jpg", "audiosrc": "engenn4le16ob05re2aud01", "images": [{"time": "0", "image": "engenn4le16ob05re2img05.jpg", "id": 0, "text": ""}, {"time": "020", "image": "engenn4le16ob05re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Chef</span>: Welcome to Lo's Lo Mein! I'm Lo.<br/>\n<span class=\"strong\">Sally</span>: Nice to meet you Lo! I saw a sign outside about hand-pulled noodles. Can you show me how you make them?<br/>\n<span class=\"strong\">Chef</span>: Yes! Follow me. Where are you visiting from? Are you enjoying China?<br/>\n<span class=\"strong\">Sally</span>: Yes! I'm from the States."}, {"time": "23000", "image": "engenn4le16ob05re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Chef</span>: So, we already have the ball of dough here. First, I divide the dough into 6 equal parts. I stretch each part into a long strip and then bring the two ends together. Then, you  stretch it again and join the ends again.  Now, I'm going to twirl and spin the whole batch so it looks like a jump rope."}, {"time": "49000", "image": "engenn4le16ob05re2img02.jpg", "id": 3, "text": "<span class=\"strong\">Sally</span>: Hey, it looks like noodles now.<br/>\n<span class=\"strong\">Chef</span>: Yes, that's how you make hand-pulled noodles in 30 seconds. I have to boil them now.<br/>\n<span class=\"strong\">Sally</span>: Can I try them?<br/>\n<span class=\"strong\">Chef</span>: Yes. I'm going to make you some Ban Mian, it's a popular noodle dish here.<br/>\n<span class=\"strong\">Sally</span>: I love sweet and sour chicken! That's my favorite Chinese dish!"}]}}], "title": "", "type": "audio", "template_override": 1}]}]}